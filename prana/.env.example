# Copy this file to .env and fill in real values. Never commit .env.

# --- Environment / API ---
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# --- Express.js <-> FastAPI service trust ---
# Shared secret used to verify HMAC-signed requests coming from the
# Express.js backend. Generate a long random value and set the SAME
# value in the Express.js service configuration.
SERVICE_SHARED_SECRET=replace-with-a-long-random-secret
REQUIRE_SERVICE_SIGNATURE=false

# --- Website scope ---
# Single source of truth for the site this chatbot answers questions about.
WEBSITE_URL=https://example.com

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_CLASSIFICATION_MODEL=gemini-2.0-flash
GEMINI_GENERATION_MODEL=gemini-2.0-flash

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=website_knowledge_base

# --- Embeddings ---
DENSE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
DENSE_EMBEDDING_DIM=384
SPARSE_EMBEDDING_MODEL=Qdrant/bm25

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
USE_SEMANTIC_CHUNKING=false

# --- Retrieval ---
TOP_K=20
RERANK_TOP_K=5
RERANKER_MODEL=BAAI/bge-reranker-base
HYBRID_DENSE_WEIGHT=0.6
MIN_RERANK_SCORE=0.35
MIN_EVIDENCE_CHUNKS=1

# --- Web fallback ---
WEB_FALLBACK_ENABLED=true
WEB_FALLBACK_MAX_PAGES=3
WEB_FALLBACK_TIMEOUT_SECONDS=8.0

# --- Validation / generation ---
MAX_GENERATION_RETRIES=1
MAX_MESSAGE_LENGTH=2000
